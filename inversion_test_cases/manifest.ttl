<#d-inv-006> a rdb2rdftest:DataBase;
    dcterms:title "Join key absent from RDF terms";
    dcterms:identifier "D-INV-006";
    rdb2rdftest:sqlScriptFile "d-inv-006.sql";
    rdb2rdftest:relatedTestCase <#INVTC0006>;
.

<#INVTC0006> a rdb2rdftest:R2RML;
    dcterms:title "Join key never emitted as an RDF term";
    dcterms:identifier "INVTC0006";
    test:purpose "Tests a self-join whose key controls relationships but is absent from every generated RDF term";
    test:specificationReference "#dfn-join-condition";
    test:reviewStatus test:unreviewed;
    rdb2rdftest:database <#d-inv-006>;
    rdb2rdftest:output "mapped.nq";
    rdb2rdftest:hasExpectedOutput true;
    rdb2rdftest:mappingDocument "r2rml.ttl";
.

<#d-inv-007> a rdb2rdftest:DataBase;
    dcterms:title "Triples Map with no predicate-object maps";
    dcterms:identifier "D-INV-007";
    rdb2rdftest:sqlScriptFile "d-inv-007.sql";
    rdb2rdftest:relatedTestCase <#INVTC0007>;
.

<#INVTC0007> a rdb2rdftest:R2RML;
    dcterms:title "Triples Map without a predicate-object map";
    dcterms:identifier "INVTC0007";
    test:purpose "Tests a non-empty logical table whose Triples Map generates no triples";
    test:specificationReference "#dfn-triples-map";
    test:reviewStatus test:unreviewed;
    rdb2rdftest:database <#d-inv-007>;
    rdb2rdftest:output "mapped.nq";
