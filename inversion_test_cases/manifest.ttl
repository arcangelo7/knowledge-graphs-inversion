@prefix test: <http://www.w3.org/2006/03/test-description#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdb2rdftest: <http://purl.org/NET/rdb2rdf-test#> .
@base <https://w3id.org/kg-inversion/test-cases/> .

<#d-inv-001a> a rdb2rdftest:DataBase; dcterms:identifier "D-INV-001A"; rdb2rdftest:sqlScriptFile "d-inv-001a.sql"; rdb2rdftest:relatedTestCase <#INVTC0001a> .
<#d-inv-001b> a rdb2rdftest:DataBase; dcterms:identifier "D-INV-001B"; rdb2rdftest:sqlScriptFile "d-inv-001b.sql"; rdb2rdftest:relatedTestCase <#INVTC0001b> .
<#d-inv-002a> a rdb2rdftest:DataBase; dcterms:identifier "D-INV-002A"; rdb2rdftest:sqlScriptFile "d-inv-002a.sql"; rdb2rdftest:relatedTestCase <#INVTC0002a> .
<#d-inv-002b> a rdb2rdftest:DataBase; dcterms:identifier "D-INV-002B"; rdb2rdftest:sqlScriptFile "d-inv-002b.sql"; rdb2rdftest:relatedTestCase <#INVTC0002b> .
<#d-inv-002c> a rdb2rdftest:DataBase; dcterms:identifier "D-INV-002C"; rdb2rdftest:sqlScriptFile "d-inv-002c.sql"; rdb2rdftest:relatedTestCase <#INVTC0002c> .
<#d-inv-002d> a rdb2rdftest:DataBase; dcterms:identifier "D-INV-002D"; rdb2rdftest:sqlScriptFile "d-inv-002d.sql"; rdb2rdftest:relatedTestCase <#INVTC0002d> .
<#d-inv-003> a rdb2rdftest:DataBase; dcterms:identifier "D-INV-003"; rdb2rdftest:sqlScriptFile "d-inv-003.sql"; rdb2rdftest:relatedTestCase <#INVTC0003> .
<#d-inv-004> a rdb2rdftest:DataBase; dcterms:identifier "D-INV-004"; rdb2rdftest:sqlScriptFile "d-inv-004.sql"; rdb2rdftest:relatedTestCase <#INVTC0004> .
<#d-inv-005a> a rdb2rdftest:DataBase; dcterms:identifier "D-INV-005A"; rdb2rdftest:sqlScriptFile "d-inv-005a.sql"; rdb2rdftest:relatedTestCase <#INVTC0005a> .
<#d-inv-005b> a rdb2rdftest:DataBase; dcterms:identifier "D-INV-005B"; rdb2rdftest:sqlScriptFile "d-inv-005b.sql"; rdb2rdftest:relatedTestCase <#INVTC0005b> .

<#INVTC0001a> a rdb2rdftest:R2RML;
    dcterms:title "Adjacent template placeholders"; dcterms:identifier "INVTC0001a";
    test:purpose "Tests the loss of column boundaries when adjacent placeholders are exposed only by one template"; test:specificationReference "#from-template"; test:reviewStatus test:unreviewed;
    rdb2rdftest:database <#d-inv-001a>; rdb2rdftest:output "mappeda.nq"; rdb2rdftest:hasExpectedOutput true; rdb2rdftest:mappingDocument "r2rmla.ttl" .

<#INVTC0001b> a rdb2rdftest:R2RML;
    dcterms:title "Template separator present in a source value"; dcterms:identifier "INVTC0001b";
    test:purpose "Tests columns whose observed template term admits more than one decomposition"; test:specificationReference "#from-template"; test:reviewStatus test:unreviewed;
    rdb2rdftest:database <#d-inv-001b>; rdb2rdftest:output "mappedb.nq"; rdb2rdftest:hasExpectedOutput true; rdb2rdftest:mappingDocument "r2rmlb.ttl" .

<#INVTC0002a> a rdb2rdftest:R2RML;
    dcterms:title "Indistinguishable subject templates"; dcterms:identifier "INVTC0002a";
    test:purpose "Tests subject-only columns that compatible templates cannot attribute to their source term map"; test:specificationReference "#from-template"; test:reviewStatus test:unreviewed;
    rdb2rdftest:database <#d-inv-002a>; rdb2rdftest:output "mappeda.nq"; rdb2rdftest:hasExpectedOutput true; rdb2rdftest:mappingDocument "r2rmla.ttl" .

<#INVTC0002b> a rdb2rdftest:R2RML;
    dcterms:title "Indistinguishable predicate templates"; dcterms:identifier "INVTC0002b";
    test:purpose "Tests predicate-only columns that compatible predicate maps cannot attribute to their source term map"; test:specificationReference "#dfn-predicate-map"; test:reviewStatus test:unreviewed;
    rdb2rdftest:database <#d-inv-002b>; rdb2rdftest:output "mappedb.nq"; rdb2rdftest:hasExpectedOutput true; rdb2rdftest:mappingDocument "r2rmlb.ttl" .

<#INVTC0002c> a rdb2rdftest:R2RML;
    dcterms:title "Indistinguishable object maps"; dcterms:identifier "INVTC0002c";
    test:purpose "Tests object-only columns that compatible object maps under one predicate cannot attribute to their source term map"; test:specificationReference "#dfn-object-map"; test:reviewStatus test:unreviewed;
    rdb2rdftest:database <#d-inv-002c>; rdb2rdftest:output "mappedc.nq"; rdb2rdftest:hasExpectedOutput true; rdb2rdftest:mappingDocument "r2rmlc.ttl" .

<#INVTC0002d> a rdb2rdftest:R2RML;
    dcterms:title "Indistinguishable graph maps"; dcterms:identifier "INVTC0002d";
    test:purpose "Tests graph-only columns that compatible graph templates cannot attribute to their source term map"; test:specificationReference "#dfn-graph-map"; test:reviewStatus test:unreviewed;
    rdb2rdftest:database <#d-inv-002d>; rdb2rdftest:output "mappedd.nq"; rdb2rdftest:hasExpectedOutput true; rdb2rdftest:mappingDocument "r2rmld.ttl" .

<#INVTC0003> a rdb2rdftest:R2RML;
    dcterms:title "Column converted directly into an IRI"; dcterms:identifier "INVTC0003";
    test:purpose "Tests a column whose value cannot be separated from the base IRI after forward mapping"; test:specificationReference "#from-column"; test:reviewStatus test:unreviewed;
    rdb2rdftest:database <#d-inv-003>; rdb2rdftest:output "mapped.nq"; rdb2rdftest:hasExpectedOutput true; rdb2rdftest:mappingDocument "r2rml.ttl" .

<#INVTC0004> a rdb2rdftest:R2RML;
    dcterms:title "Join key never emitted as an RDF term"; dcterms:identifier "INVTC0004";
    test:purpose "Tests a self-join whose key controls relationships but is absent from every generated RDF term"; test:specificationReference "#dfn-join-condition"; test:reviewStatus test:unreviewed;
    rdb2rdftest:database <#d-inv-004>; rdb2rdftest:output "mapped.nq"; rdb2rdftest:hasExpectedOutput true; rdb2rdftest:mappingDocument "r2rml.ttl" .

<#INVTC0005a> a rdb2rdftest:R2RML;
    dcterms:title "Join target reached only as an RDF object"; dcterms:identifier "INVTC0005a";
    test:purpose "Tests a parent Triples Map without predicate-object maps whose subject identifier is recoverable from reference object map triples"; test:specificationReference "#dfn-parent-triples-map"; test:reviewStatus test:unreviewed;
    rdb2rdftest:database <#d-inv-005a>; rdb2rdftest:output "mappeda.nq"; rdb2rdftest:hasExpectedOutput true; rdb2rdftest:mappingDocument "r2rmla.ttl" .

<#INVTC0005b> a rdb2rdftest:R2RML;
    dcterms:title "Triples Map without a predicate-object map"; dcterms:identifier "INVTC0005b";
    test:purpose "Tests a non-empty logical table whose Triples Map generates no triples"; test:specificationReference "#dfn-triples-map"; test:reviewStatus test:unreviewed;
    rdb2rdftest:database <#d-inv-005b>; rdb2rdftest:output "mappedb.nq"; rdb2rdftest:hasExpectedOutput true; rdb2rdftest:mappingDocument "r2rmlb.ttl" .
