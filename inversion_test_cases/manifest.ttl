<#d-inv-005> a rdb2rdftest:DataBase;
    dcterms:title "Column-valued IRI term map";
    dcterms:identifier "D-INV-005";
    rdb2rdftest:sqlScriptFile "d-inv-005.sql";
    rdb2rdftest:relatedTestCase <#INVTC0005>;
.

<#INVTC0005> a rdb2rdftest:R2RML;
    dcterms:title "Column converted directly into an IRI";
    dcterms:identifier "INVTC0005";
    test:purpose "Tests a column whose value cannot be separated from the base IRI after forward mapping";
    test:specificationReference "#from-column";
    test:reviewStatus test:unreviewed;
    rdb2rdftest:database <#d-inv-005>;
    rdb2rdftest:output "mapped.nq";
