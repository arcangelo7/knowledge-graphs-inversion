@prefix test: <http://www.w3.org/2006/03/test-description#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdb2rdftest: <http://purl.org/NET/rdb2rdf-test#> .
@base <https://w3id.org/kg-inversion/test-cases/> .

<#d-inv-001> a rdb2rdftest:DataBase;
    dcterms:title "Adjacent template values";
    dcterms:identifier "D-INV-001";
    rdb2rdftest:sqlScriptFile "d-inv-001.sql";
    rdb2rdftest:relatedTestCase <#INVTC0001>;
.

<#INVTC0001> a rdb2rdftest:R2RML;
    dcterms:title "Adjacent template placeholders without other evidence";
    dcterms:identifier "INVTC0001";
    test:purpose "Tests the loss of column boundaries when adjacent placeholders are exposed only by one template";
    test:specificationReference "#from-template";
    test:reviewStatus test:unreviewed;
    rdb2rdftest:database <#d-inv-001>;
    rdb2rdftest:output "mapped.nq";
    rdb2rdftest:hasExpectedOutput true;
    rdb2rdftest:mappingDocument "r2rml.ttl";
.

<#d-inv-002> a rdb2rdftest:DataBase;
    dcterms:title "Indistinguishable subject templates";
    dcterms:identifier "D-INV-002";
    rdb2rdftest:sqlScriptFile "d-inv-002.sql";
    rdb2rdftest:relatedTestCase <#INVTC0002>;
.

<#INVTC0002> a rdb2rdftest:R2RML;
    dcterms:title "Indistinguishable subject templates";
    dcterms:identifier "INVTC0002";
    test:purpose "Tests subject-only columns that compatible templates cannot attribute to their source term map";
    test:specificationReference "#from-template";
    test:reviewStatus test:unreviewed;
    rdb2rdftest:database <#d-inv-002>;
    rdb2rdftest:output "mapped.nq";
    rdb2rdftest:hasExpectedOutput true;
    rdb2rdftest:mappingDocument "r2rml.ttl";
.

