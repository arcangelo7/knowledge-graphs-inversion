<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RML inversion test interface</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Prism.js CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/themes/prism-okaidia.min.css" rel="stylesheet" />

    <!-- Prism.js Core and SQL language support -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/components/prism-sql.min.js"></script>

    <style>
        :root {
            --bg-primary: #ffffff;
            --bg-secondary: #f8f9fa;
            --bg-tertiary: #e9ecef;
            --text-primary: #212529;
            --text-secondary: #6c757d;
            --border-color: #dee2e6;
            --pre-bg: #f8f9fa;
            --pre-border: #e9ecef;
            --modal-bg: #fefefe;
            --modal-border: #888;
            --close-color: #aaa;
            --close-hover: black;
            --overlay-bg: rgba(0,0,0,0.4);
            --link-color: #0d6efd;
            --suite-r2rml-bg: #e3f2fd;
            --suite-r2rml-color: #1565c0;
            --suite-rml-bg: #f3e5f5;
            --suite-rml-color: #7b1fa2;
            --engine-forward-bg: #e3f2fd;
            --engine-forward-color: #1565c0;
            --engine-inversion-bg: #e0f7fa;
            --engine-inversion-color: #00796b;
            --engine-arrow-color: #6c757d;
            --table-striped-bg: rgba(0,0,0,0.05);
            --input-bg: #fff;
            --input-border: #ced4da;
            --input-color: #212529;
            --footer-bg: #f8f9fa;
        }
        [data-theme="dark"] {
            --bg-primary: #1a1a2e;
            --bg-secondary: #16213e;
            --bg-tertiary: #0f3460;
            --text-primary: #e0e0e0;
            --text-secondary: #a0a0b0;
            --border-color: #2a2a4a;
            --pre-bg: #0d1117;
            --pre-border: #30363d;
            --modal-bg: #1a1a2e;
            --modal-border: #2a2a4a;
            --close-color: #a0a0b0;
            --close-hover: #e0e0e0;
            --overlay-bg: rgba(0,0,0,0.7);
            --link-color: #58a6ff;
            --suite-r2rml-bg: #0d2137;
            --suite-r2rml-color: #58a6ff;
            --suite-rml-bg: #2a1533;
            --suite-rml-color: #d2a8ff;
            --engine-forward-bg: #0d2137;
            --engine-forward-color: #58a6ff;
            --engine-inversion-bg: #0d302d;
            --engine-inversion-color: #56d4c2;
            --engine-arrow-color: #a0a0b0;
            --table-striped-bg: rgba(255,255,255,0.05);
            --input-bg: #0d1117;
            --input-border: #30363d;
            --input-color: #e0e0e0;
            --footer-bg: #16213e;
        }
        html, body {
            height: 100%;
        }
        body {
            display: flex;
            flex-direction: column;
            background-color: var(--bg-primary);
            color: var(--text-primary);
            transition: background-color 0.3s, color 0.3s;
        }
        .content {
            flex: 1 0 auto;
        }
        .footer {
            flex-shrink: 0;
            background-color: var(--footer-bg) !important;
        }
        .footer a {
            color: var(--link-color);
        }
        .footer h5, .footer p {
            color: var(--text-primary);
        }
        pre {
            background-color: var(--pre-bg);
            border: 1px solid var(--pre-border);
            border-radius: 0.25rem;
            padding: 1rem;
            white-space: pre-wrap;
            word-wrap: break-word;
            color: var(--text-primary);
        }
        a {
            color: var(--link-color);
        }
        .form-select, .form-control {
            background-color: var(--input-bg);
            border-color: var(--input-border);
            color: var(--input-color);
        }
        .form-label {
            color: var(--text-primary);
        }
        .table {
            color: var(--text-primary);
        }
        .table-striped > tbody > tr:nth-of-type(odd) > * {
            --bs-table-accent-bg: var(--table-striped-bg);
            color: var(--text-primary);
        }
        .result-passed {
            color: #28a745 !important;
            font-weight: bold;
        }
        .result-failed {
            color: #dc3545 !important;
            font-weight: bold;
        }
        .result-not-supported {
            color: #ffc107 !important;
            font-weight: bold;
        }
        .result-not-tested {
            color: #6c757d !important;
            font-weight: bold;
        }
        .result-partially-inverted {
            color: #0dcaf0 !important;
            font-weight: bold;
        }
        .result-non-invertible {
            color: #fd7e14 !important;
            font-weight: bold;
        }
        .result-forward-mapping-failed {
            color: #6f42c1 !important;
            font-weight: bold;
        }
        [data-theme="dark"] .result-passed { color: #3fb950 !important; }
        [data-theme="dark"] .result-failed { color: #f85149 !important; }
        [data-theme="dark"] .result-not-supported { color: #d29922 !important; }
        [data-theme="dark"] .result-not-tested { color: #8b949e !important; }
        [data-theme="dark"] .result-partially-inverted { color: #39c0e2 !important; }
        [data-theme="dark"] .result-non-invertible { color: #db6d28 !important; }
        [data-theme="dark"] .result-forward-mapping-failed { color: #a371f7 !important; }
        .table-striped > tbody > tr:nth-of-type(odd) .result-passed,
        .table-striped > tbody > tr:nth-of-type(odd) .result-failed,
        .table-striped > tbody > tr:nth-of-type(odd) .result-not-supported,
        .table-striped > tbody > tr:nth-of-type(odd) .result-not-tested,
        .table-striped > tbody > tr:nth-of-type(odd) .result-partially-inverted,
        .table-striped > tbody > tr:nth-of-type(odd) .result-non-invertible,
        .table-striped > tbody > tr:nth-of-type(odd) .result-forward-mapping-failed {
            color: inherit;
        }
        .error-test-badge {
            display: inline-block;
            background-color: #6c757d;
            color: white;
            font-size: 0.7em;
            padding: 1px 5px;
            border-radius: 3px;
            margin-left: 5px;
            vertical-align: middle;
        }
        .info-icon {
            cursor: help;
            color: var(--text-secondary);
            font-size: 0.9em;
            vertical-align: super;
            margin-left: 2px;
        }
        .info-icon:hover {
            color: var(--text-primary);
        }
        .spinner-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100px;
        }
        .loading-row td {
            text-align: center;
            padding: 10px;
        }
        .loading-row .loading-dots::after {
            content: '.';
            animation: dots 1.5s steps(5, end) infinite;
        }
        @keyframes dots {
            0%, 20% { content: '.'; }
            40% { content: '..'; }
            60% { content: '...'; }
            80%, 100% { content: ''; }
        }
        .modal {
            display: none;
            position: fixed;
            z-index: 1;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: var(--overlay-bg);
        }
        .modal-content {
            background-color: var(--modal-bg);
            margin: 15% auto;
            padding: 20px;
            border: 1px solid var(--modal-border);
            width: 80%;
            color: var(--text-primary);
        }
        .close {
            color: var(--close-color);
            float: right;
            font-size: 28px;
            font-weight: bold;
        }
        .close:hover,
        .close:focus {
            color: var(--close-hover);
            text-decoration: none;
            cursor: pointer;
        }
        #modalContent .language-sql {
            background: #272822;
            color: #f8f8f2;
            text-shadow: 0 1px rgba(0, 0, 0, 0.3);
            font-family: Consolas, Monaco, 'Andale Mono', 'Ubuntu Mono', monospace;
        }
        .stats-box {
            background-color: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 0.25rem;
            padding: 1rem;
            margin-bottom: 1.5rem;
            display: none;
        }
        .stats-row {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            gap: 1rem;
        }
        .stat-item {
            text-align: center;
            flex: 1;
            min-width: 120px;
        }
        .stat-value {
            font-size: 2rem;
            font-weight: bold;
            margin-bottom: 0.25rem;
        }
        .stat-label {
            font-size: 0.875rem;
            color: var(--text-secondary);
        }
        .stat-passed { color: #28a745; }
        .stat-failed { color: #dc3545; }
        .stat-not-supported { color: #ffc107; }
        .stat-not-tested { color: #6c757d; }
        .stat-partially-inverted { color: #0dcaf0; }
        .stat-non-invertible { color: #fd7e14; }
        .stat-forward-mapping-failed { color: #6f42c1; }
        [data-theme="dark"] .stat-passed { color: #3fb950; }
        [data-theme="dark"] .stat-failed { color: #f85149; }
        [data-theme="dark"] .stat-not-supported { color: #d29922; }
        [data-theme="dark"] .stat-not-tested { color: #8b949e; }
        [data-theme="dark"] .stat-partially-inverted { color: #39c0e2; }
        [data-theme="dark"] .stat-non-invertible { color: #db6d28; }
        [data-theme="dark"] .stat-forward-mapping-failed { color: #a371f7; }
        .suite-badge {
            font-size: 0.7em;
            padding: 2px 6px;
            border-radius: 3px;
            margin-left: 6px;
            vertical-align: middle;
        }
        .suite-r2rml { background-color: var(--suite-r2rml-bg); color: var(--suite-r2rml-color); }
        .suite-rml { background-color: var(--suite-rml-bg); color: var(--suite-rml-color); }
        .engine-flow {
            display: flex;
            align-items: center;
            min-height: 1.5rem;
            gap: 0.4rem;
            margin-bottom: 1rem;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        }
        .engine-node, .engine-pair-badge {
            display: inline-block;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
            line-height: 1;
            padding: 0.35rem 0.55rem;
        }
        .engine-forward {
            background: var(--engine-forward-bg);
            color: var(--engine-forward-color);
        }
        .engine-inversion {
            background: var(--engine-inversion-bg);
            color: var(--engine-inversion-color);
        }
        .engine-arrow {
            color: var(--engine-arrow-color);
        }
        .engine-arrow, .engine-pair-arrow {
            display: inline-flex;
            align-items: center;
            line-height: 1;
            transform: translateY(-0.08em);
        }
        .engine-pair-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            margin-left: 0.45rem;
            background: var(--engine-inversion-bg);
            color: var(--engine-inversion-color);
            vertical-align: middle;
        }
        .suite-panels {
            display: flex;
            gap: 1.5rem;
        }
        .suite-panel {
            flex: 1;
            min-width: 0;
        }
        .suite-panel h3 {
            font-size: 1.15rem;
            margin-bottom: 0.5rem;
        }
        .suite-panel-stats {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            padding: 0.5rem 0.75rem;
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 0.25rem;
            margin-bottom: 0.75rem;
        }
        .suite-panel-table {
            max-height: 70vh;
            overflow-y: auto;
            overflow-x: auto;
        }
        .theme-toggle {
            position: fixed;
            top: 1rem;
            right: 1rem;
            z-index: 1000;
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 1.2rem;
            color: var(--text-primary);
            transition: background-color 0.3s, border-color 0.3s;
        }
        .theme-toggle:hover {
            background: var(--bg-tertiary);
        }
        @media (max-width: 991px) {
            .suite-panels {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <button class="theme-toggle" id="themeToggle" title="Toggle dark mode">
        <i class="fas fa-moon" id="themeIcon"></i>
    </button>
    <div class="container-fluid mt-5 px-4">
        <h1 class="mb-4">RML inversion test interface</h1>
        <div class="row">
            <div class="col-md-6 col-lg-3">
                <label for="enginePairSelect" class="form-label">Execution pair</label>
                <select id="enginePairSelect" class="form-select mb-2">
                    {% for engine_pair, engine in engine_options.items() %}
                    <option value="{{ engine_pair }}" {% if engine_pair == default_engine_pair %}selected{% endif %}>{{ engine.label }}</option>
                    {% endfor %}
                </select>
                <div id="engineFlow" class="engine-flow" aria-live="polite"></div>
            </div>
            <div class="col-md-6 col-lg-3">
                <label for="databaseSelect" class="form-label">Database</label>
                <select id="databaseSelect" class="form-select mb-3">
                    {% for database_system, database in database_options.items() %}
                    <option value="{{ database_system }}">{{ database.label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-6 col-lg-3">
                <label for="suiteSelect" class="form-label">Test suite</label>
                <select id="suiteSelect" class="form-select mb-3">
                    <option value="all">All suites</option>
                    {% for suite_id, suite in suites.items() %}
                    <option value="{{ suite_id }}">{{ suite.name }}</option>
                    {% endfor %}
                </select>
                <div id="suiteAvailabilityMessage" class="form-text mb-3" role="status"></div>
            </div>
            <div class="col-md-6 col-lg-3">
                <label for="testSelect" class="form-label">Test case</label>
                <select id="testSelect" class="form-select mb-3">
                    <option value="">Select a test</option>
                </select>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col">
                <button id="runTestBtn" onclick="runTest()" class="btn btn-primary" disabled>Run test</button>
                <button id="runAllTestsBtn" onclick="runAllTests()" class="btn btn-success">Run all tests</button>
            </div>
        </div>
        <div id="mappingContent" class="mb-4" style="display: none;">
            <h2>Mapping</h2>
            <pre><code id="mappingCode"></code></pre>
        </div>
        <div id="results">
            <div id="spinner" class="spinner-container" style="display: none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
            <div id="stats-box" class="stats-box">
                <h5 class="mb-3">Test execution summary</h5>
                <div class="stats-row">
                    <div class="stat-item">
                        <div class="stat-value" id="stat-total">0</div>
                        <div class="stat-label">Total tests</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value stat-passed" id="stat-passed">0</div>
                        <div class="stat-label">Fully inverted (<span id="stat-passed-percent">0</span>%)</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value stat-partially-inverted" id="stat-partially-inverted">0</div>
                        <div class="stat-label">Partially inverted (<span id="stat-partially-inverted-percent">0</span>%)</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value stat-non-invertible" id="stat-non-invertible">0</div>
                        <div class="stat-label">Non-invertible (<span id="stat-non-invertible-percent">0</span>%)</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value stat-not-supported" id="stat-not-supported">0</div>
                        <div class="stat-label">Not supported (<span id="stat-not-supported-percent">0</span>%)</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value stat-not-tested" id="stat-not-tested">0</div>
                        <div class="stat-label">Not tested (<span id="stat-not-tested-percent">0</span>%)</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value stat-forward-mapping-failed" id="stat-forward-mapping-failed">0</div>
                        <div class="stat-label">Forward mapping failed (<span id="stat-forward-mapping-failed-percent">0</span>%)</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value stat-failed" id="stat-failed">0</div>
                        <div class="stat-label">Failed (<span id="stat-failed-percent">0</span>%)</div>
                    </div>
                </div>
            </div>
            <table id="results-table" class="table table-striped" style="display: none;">
                <thead>
                    <tr id="results-header"></tr>
                </thead>
                <tbody id="results-body"></tbody>
            </table>
        </div>
    </div>

    <div id="infoModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2 id="modalTitle"></h2>
            <pre id="modalContent"></pre>
        </div>
    </div>

    <footer class="footer mt-auto py-3 bg-light">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 col-md-12 mb-4 mb-md-0">
                    <h5 class="text-uppercase">Source code</h5>
                    <ul class="list-unstyled mb-0">
                        <li>
                            <a href="https://github.com/arcangelo7/knowledge-graphs-inversion" target="_blank" rel="noopener noreferrer">
                                <i class="fab fa-github"></i> knowledge-graphs-inversion
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="col-lg-6 col-md-12 mb-4 mb-md-0">
                    <h5 class="text-uppercase">Contact</h5>
                    <p>Arcangelo Massari</p>
                    <p>Email: <a href="mailto:arcangelo.massari@unibo.it">arcangelo.massari@unibo.it</a></p>
                    <p>2026 ISC Licence</p>
                </div>
            </div>
        </div>
    </footer>

    <script>
        (function() {
            const saved = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = saved || (prefersDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
            const icon = document.getElementById('themeIcon');
            if (icon) icon.className = theme === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
        })();

        document.getElementById('themeToggle').addEventListener('click', function() {
            const current = document.documentElement.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
            document.getElementById('themeIcon').className = next === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
        });

        const allTests = {{ all_tests | tojson }};
        const databaseOptions = {{ database_options | tojson }};
        const engineOptions = {{ engine_options | tojson }};
        const rmlMysqlUnavailable = {{ rml_mysql_unavailable | tojson }};
        const souffleRmlUnavailable = {{ souffle_rml_unavailable | tojson }};
        const testResults = {};
        let testStats = {
            total: 0,
            passed: 0,
            failed: 0,
            notSupported: 0,
            notTested: 0,
            partiallyInverted: 0,
            nonInvertible: 0,
            forwardMappingFailed: 0
        };
        let suiteStats = {};
        const resultHeaders = ['Suite', 'Test ID', 'Purpose', 'Result', 'Expected Result', 'Actual Result', 'Mapping', 'Inversion Success', 'Table Comparison'];
        const compactHeaders = ['Test ID', 'Result', 'Expected', 'Actual', 'Mapping', 'Inversion Success', 'Comparison'];

        function getSelectedSuiteId() {
            return $('#suiteSelect').val();
        }

        function getSelectedDatabaseSystem() {
            return $('#databaseSelect').val();
        }

        function getSelectedEnginePair() {
            return $('#enginePairSelect').val();
        }

        function getAvailableSuiteIds() {
            const databaseSuites = databaseOptions[getSelectedDatabaseSystem()].suite_ids;
            const engineSuites = engineOptions[getSelectedEnginePair()].suite_ids;
            return databaseSuites.filter(suiteId => engineSuites.includes(suiteId));
        }

        function updateEngineFlow() {
            const engine = engineOptions[getSelectedEnginePair()];
            $('#engineFlow').html(
                `<span class="engine-node engine-forward">${escapeHtml(engine.forward)}</span>` +
                '<span class="engine-arrow" aria-hidden="true">→</span>' +
                `<span class="engine-node engine-inversion">${escapeHtml(engine.inversion)}</span>`
            );
        }

        function getEnginePairBadge(enginePair) {
            const engine = engineOptions[enginePair];
            return (
                `<span class="engine-pair-badge" aria-label="${escapeHtml(engine.label)}">` +
                `<span>${escapeHtml(engine.forward)}</span>` +
                '<span class="engine-pair-arrow" aria-hidden="true">→</span>' +
                `<span>${escapeHtml(engine.inversion)}</span>` +
                '</span>'
            );
        }

        function updateSuiteAvailability() {
            const availableSuiteIds = getAvailableSuiteIds();
            const souffleSelected = getSelectedEnginePair() === 'souffle_souffle';
            $('#suiteSelect option').each(function() {
                const suiteId = $(this).val();
                const unavailable = suiteId === 'all'
                    ? souffleSelected
                    : !availableSuiteIds.includes(suiteId);
                $(this).prop('disabled', unavailable);
            });

            if (
                !availableSuiteIds.includes(getSelectedSuiteId()) &&
                (getSelectedSuiteId() !== 'all' || souffleSelected)
            ) {
                $('#suiteSelect').val(availableSuiteIds[0]);
            }

            const message = souffleSelected
                ? souffleRmlUnavailable
                : availableSuiteIds.includes('rml') ? '' : rmlMysqlUnavailable;
            $('#suiteAvailabilityMessage').text(message);
        }

        function updateTestSelect() {
            const suiteId = getSelectedSuiteId();
            const availableSuiteIds = getAvailableSuiteIds();
            const testSelect = $('#testSelect');
            testSelect.empty();
            testSelect.append('<option value="">Select a test</option>');

            if (suiteId === 'all') {
                for (const sid of availableSuiteIds) {
                    const tests = allTests[sid];
                    const suiteName = sid.toUpperCase();
                    tests.forEach(test => {
                        testSelect.append(`<option value="${test}" data-suite="${sid}">${test} [${suiteName}]</option>`);
                    });
                }
            } else if (availableSuiteIds.includes(suiteId) && allTests[suiteId]) {
                allTests[suiteId].forEach(test => {
                    testSelect.append(`<option value="${test}" data-suite="${suiteId}">${test}</option>`);
                });
            }
            $('#runTestBtn').prop('disabled', true);
        }

        function updateStats() {
            const total = testStats.total;
            $('#stat-total').text(total);
            $('#stat-passed').text(testStats.passed);
            $('#stat-failed').text(testStats.failed);
            $('#stat-not-supported').text(testStats.notSupported);
            $('#stat-not-tested').text(testStats.notTested);
            $('#stat-partially-inverted').text(testStats.partiallyInverted);
            $('#stat-non-invertible').text(testStats.nonInvertible);
            $('#stat-forward-mapping-failed').text(testStats.forwardMappingFailed);

            if (total > 0) {
                $('#stat-passed-percent').text(Math.round((testStats.passed / total) * 100));
                $('#stat-failed-percent').text(Math.round((testStats.failed / total) * 100));
                $('#stat-not-supported-percent').text(Math.round((testStats.notSupported / total) * 100));
                $('#stat-not-tested-percent').text(Math.round((testStats.notTested / total) * 100));
                $('#stat-partially-inverted-percent').text(Math.round((testStats.partiallyInverted / total) * 100));
                $('#stat-non-invertible-percent').text(Math.round((testStats.nonInvertible / total) * 100));
                $('#stat-forward-mapping-failed-percent').text(Math.round((testStats.forwardMappingFailed / total) * 100));
            }
        }

        function resetStats() {
            testStats = {
                total: 0,
                passed: 0,
                failed: 0,
                notSupported: 0,
                notTested: 0,
                partiallyInverted: 0,
                nonInvertible: 0,
                forwardMappingFailed: 0
            };
            updateStats();
        }

        function disableButtons() {
            $('#runTestBtn, #runAllTestsBtn').prop('disabled', true);
        }

        function enableButtons() {
            $('#runAllTestsBtn').prop('disabled', false);
            if ($('#testSelect').val()) {
                $('#runTestBtn').prop('disabled', false);
            }
        }

        function getSuiteForTest() {
            const selected = $('#testSelect option:selected');
            return selected.data('suite') || getSelectedSuiteId();
        }

        function runTest() {
            const testId = $('#testSelect').val();
            const suiteId = getSuiteForTest();
            const dbSystem = getSelectedDatabaseSystem();
            const enginePair = getSelectedEnginePair();
            const resultsDiv = $('#results');

            resultsDiv.children().not('#stats-box').remove();
            $('#stats-box').hide();
            resultsDiv.append('<div id="spinner" class="spinner-container"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>');

            disableButtons();

            $.post('/run_test', {
                test_id: testId,
                database_system: dbSystem,
                suite_id: suiteId,
                engine_pair: enginePair
            })
            .done(function(response) {
                response.suite_id = suiteId;
                testResults[response.test_id] = response;
                displayTestResults(response);
            })
            .fail(function(jqXHR, textStatus, errorThrown) {
                const message = jqXHR.responseJSON && jqXHR.responseJSON.error ? jqXHR.responseJSON.error : textStatus;
                resultsDiv.html('<p class="text-danger">Error: ' + escapeHtml(message) + '</p>');
            })
            .always(function() {
                $('#spinner').remove();
                enableButtons();
            });
        }

        function runAllTests() {
            const dbSystem = getSelectedDatabaseSystem();
            const suiteId = getSelectedSuiteId();
            const enginePair = getSelectedEnginePair();
            const selectedSuiteIds = suiteId === 'all' ? getAvailableSuiteIds() : [suiteId];
            const suiteParam = selectedSuiteIds.join(',');
            const resultsDiv = $('#results');
            const isDualPanel = selectedSuiteIds.length > 1;

            resultsDiv.children().not('#stats-box').remove();
            $('#stats-box').hide();

            const spinnerElement = $('<div id="spinner" class="spinner-container"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>');
            resultsDiv.append(spinnerElement);

            if (isDualPanel) {
                resetAllSuiteStats(selectedSuiteIds);
                let wrapperHtml = '<div id="dual-panel-wrapper" style="display:none;">';
                wrapperHtml += `<h2>Test results (All suites) ${getEnginePairBadge(enginePair)}</h2>`;
                wrapperHtml += '<div class="suite-panels">';
                selectedSuiteIds.forEach(sid => {
                    wrapperHtml += createSuitePanelHtml(sid);
                });
                wrapperHtml += '</div></div>';
                resultsDiv.append(wrapperHtml);
            } else {
                const resultsTable = $('<table id="results-table" class="table table-striped" style="display: none;"><thead><tr id="results-header"></tr></thead><tbody id="results-body"></tbody></table>');
                resultsDiv.append(resultsTable);
            }

            disableButtons();

            const eventSource = new EventSource(
                `/run_all_tests?database_system=${encodeURIComponent(dbSystem)}` +
                `&suite_id=${encodeURIComponent(suiteParam)}` +
                `&engine_pair=${encodeURIComponent(enginePair)}`
            );

            eventSource.onmessage = function(event) {
                const testResult = JSON.parse(event.data);
                testResults[testResult.test_id] = testResult;

                if (spinnerElement.is(":visible")) {
                    spinnerElement.hide();
                    if (isDualPanel) {
                        $('#dual-panel-wrapper').show();
                        selectedSuiteIds.forEach(sid => {
                            const cols = compactHeaders.length;
                            $(`#panel-body-${sid}`).append(`<tr class="loading-row"><td colspan="${cols}">Loading<span class="loading-dots"></span></td></tr>`);
                        });
                    } else {
                        resetStats();
                        resultsDiv.children('h2').remove();
                        const titleSuffix = suiteId === 'all' ? 'All suites' : suiteId.toUpperCase();
                        resultsDiv.prepend(
                            `<h2>Test results (${titleSuffix}) ${getEnginePairBadge(enginePair)}</h2>`
                        );
                        $('#stats-box').show();
                        $('#results-table').show();
                        if ($('#results-header').is(":empty")) {
                            updateHeaderRow();
                        }
                        addLoadingRow();
                    }
                }

                const sid = testResult.suite_id || selectedSuiteIds[0];
                const hasData = testResult.results && testResult.results.data && testResult.results.data[0];
                const isError = testResult.status === 'error';

                if (hasData || isError) {
                    if (isDualPanel) {
                        if (hasData) {
                            trackSuiteStat(sid, testResult.results.data[0]);
                        } else {
                            trackSuiteStat(sid, { inversion_success: 'error' });
                        }
                        updateSuiteStatsDisplay(sid);
                        const rowHtml = isError && !hasData ? generateErrorRow(testResult) : generateCompactRow(testResult);
                        const newRow = $(rowHtml);
                        const loadingRow = $(`#panel-body-${sid} .loading-row`);
                        if (loadingRow.length) loadingRow.before(newRow);
                        else $(`#panel-body-${sid}`).append(newRow);
                        initializeTooltips(newRow[0]);
                        if (suiteStats[sid].total >= allTests[sid].length) {
                            $(`#panel-body-${sid} .loading-row`).remove();
                        }
                    } else {
                        testStats.total++;
                        if (hasData) {
                            const row = testResult.results.data[0];
                            const status = classifyInversionStatus(row.inversion_success, row.comparison_message);
                            testStats[status.category]++;
                        } else {
                            testStats.failed++;
                        }
                        updateStats();

                        const rowHtml = isError && !hasData ? generateErrorRow(testResult) : generateResultRow(testResult);
                        const newRow = $(rowHtml);
                        $('#results-body .loading-row').before(newRow);
                        initializeTooltips(newRow[0]);
                    }
                }
            };

            eventSource.onerror = function(event) {
                console.error('EventSource failed:', event);
                eventSource.close();
                resultsDiv.append('<p class="text-danger">Error: Failed to receive all test results</p>');
                if (isDualPanel) {
                    selectedSuiteIds.forEach(sid => $(`#panel-body-${sid} .loading-row`).remove());
                } else {
                    removeLoadingRow();
                }
            };

            eventSource.onopen = function(event) {
                console.log('EventSource connected.');
            };

            eventSource.addEventListener('complete', function(event) {
                console.log('All tests completed');
                eventSource.close();
                enableButtons();
                if (isDualPanel) {
                    selectedSuiteIds.forEach(sid => $(`#panel-body-${sid} .loading-row`).remove());
                } else {
                    removeLoadingRow();
                }
            }, false);
        }

        function addLoadingRow() {
            const columnCount = $('#results-header th').length;
            const loadingRow = $('<tr class="loading-row"><td colspan="' + columnCount + '">Loading more results<span class="loading-dots"></span></td></tr>');
            $('#results-body').append(loadingRow);
        }

        function removeLoadingRow() {
            $('#results-body .loading-row').remove();
        }

        function displayTestResults(response) {
            const resultsDiv = $('#results');
            $('#stats-box').hide();
            resultsDiv.children().not('#stats-box').remove();

            if (response.status === 'success') {
                let resultsHtml = `<h2>Test results for ${response.test_id} ${getEnginePairBadge(response.engine_pair)}</h2>`;
                resultsHtml += generateResultTable(response);
                resultsDiv.append(resultsHtml);
            } else {
                let errorHtml = `<h2 class="text-danger">Error in ${response.test_id}:</h2>`;
                errorHtml += '<p>' + response.message + '</p>';
                if (response.traceback) {
                    errorHtml += '<h3>Traceback:</h3>';
                    errorHtml += '<pre>' + response.traceback + '</pre>';
                }
                resultsDiv.append(errorHtml);
            }
        }

        function generateResultTable(response) {
            let tableHtml = '<table class="table table-striped">';
            tableHtml += '<thead><tr>';
            resultHeaders.forEach(header => {
                tableHtml += `<th>${header}</th>`;
            });
            tableHtml += '</tr></thead><tbody>';
            response.results.data.forEach(row => {
                tableHtml += generateResultRow(response);
            });
            tableHtml += '</tbody></table>';
            return tableHtml;
        }

        function getSuiteBadge(suiteId) {
            if (!suiteId) return '';
            const name = suiteId.toUpperCase();
            return `<span class="suite-badge suite-${suiteId}">${name}</span>`;
        }

        function generateResultRow(response) {
            if (!response || !response.results || !Array.isArray(response.results.data) || response.results.data.length === 0) {
                console.error('Invalid response structure:', response);
                return `<tr><td colspan="${resultHeaders.length}">Error: Invalid test result structure</td></tr>`;
            }

            const row = response.results.data[0];
            const suiteId = response.suite_id || 'r2rml';
            let rowHtml = '<tr>';
            rowHtml += `<td>${getSuiteBadge(suiteId)}</td>`;
            const errorBadge = row.error_test ? '<span class="error-test-badge">error test</span>' : '';
            rowHtml += `<td>${row.testid || 'N/A'}${errorBadge}</td>`;
            rowHtml += `<td>${row.purpose || 'N/A'}</td>`;
            rowHtml += `<td class="result-${(row.result || '').toLowerCase()}">${row.result || 'N/A'}</td>`;
            rowHtml += `<td><button onclick="showFileContent('${row.testid}', 'expected')">View</button></td>`;
            rowHtml += `<td><button onclick="showFileContent('${row.testid}', 'actual')">View</button></td>`;
            rowHtml += `<td><button onclick="showMapping('${row.testid}')">View</button></td>`;
            const invStatus = classifyInversionStatus(row.inversion_success, row.comparison_message);
            const tooltipHtml = invStatus.tooltip ? ` <i class="bi bi-info-circle info-icon" data-bs-toggle="tooltip" data-bs-placement="top" title="${invStatus.tooltip}"></i>` : '';
            rowHtml += `<td class="result-${invStatus.cls}">${invStatus.text}${tooltipHtml}</td>`;
            rowHtml += `<td><button onclick="showTableComparison('${row.testid}')">View</button></td>`;
            rowHtml += '</tr>';
            return rowHtml;
        }

        function showFileContent(testId, fileType) {
            const response = testResults[testId];
            if (response && response.results && response.results.data && response.results.data[0]) {
                const content = fileType === 'expected' ? response.results.data[0].expected_result : response.results.data[0].actual_result;
                showModal(`${fileType.charAt(0).toUpperCase() + fileType.slice(1)} output for ${testId}`, `<pre style="white-space: pre-wrap; word-wrap: break-word;">${escapeHtml(content)}</pre>`);
            } else {
                showModal('Error', `Unable to display ${fileType} content. Invalid data structure.`);
            }
        }

        function escapeHtml(unsafe) {
            return unsafe
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function updateHeaderRow() {
            const headerHtml = resultHeaders
                .map(header => `<th>${header}</th>`)
                .join('');
            $('#results-header').html(headerHtml);
        }

        function classifyInversionStatus(inversionSuccess, comparisonMessage) {
            if (inversionSuccess === 'not_tested') return { cls: 'not-tested', text: 'Not tested', category: 'notTested', tooltip: comparisonMessage.replace(/'/g, '&apos;') };
            if (inversionSuccess === 'not_supported') return { cls: 'not-supported', text: 'Not Supported', category: 'notSupported', tooltip: (comparisonMessage || 'Not supported').replace(/'/g, '&apos;') };
            if (inversionSuccess === 'partially_inverted') return { cls: 'partially-inverted', text: 'Partially Inverted', category: 'partiallyInverted', tooltip: (comparisonMessage || 'Partially inverted').replace(/'/g, '&apos;') };
            if (inversionSuccess === 'non_invertible') return { cls: 'non-invertible', text: 'Non-invertible', category: 'nonInvertible', tooltip: (comparisonMessage || 'Non-invertible').replace(/'/g, '&apos;') };
            if (inversionSuccess === 'forward_mapping_failed') return { cls: 'forward-mapping-failed', text: 'Forward Mapping Failed', category: 'forwardMappingFailed', tooltip: (comparisonMessage || 'Forward mapping failed').replace(/'/g, '&apos;') };
            if (inversionSuccess === 'error') return { cls: 'failed', text: 'Error', category: 'failed', tooltip: (comparisonMessage || 'Error').replace(/'/g, '&apos;') };
            if (inversionSuccess === true) return { cls: 'passed', text: 'Fully Inverted', category: 'passed', tooltip: '' };
            return { cls: 'failed', text: 'Failure', category: 'failed', tooltip: '' };
        }

        function resetAllSuiteStats(suiteIds) {
            suiteStats = {};
            suiteIds.forEach(sid => {
                suiteStats[sid] = { total: 0, passed: 0, failed: 0, notSupported: 0, notTested: 0, partiallyInverted: 0, nonInvertible: 0, forwardMappingFailed: 0 };
            });
        }

        function trackSuiteStat(sid, row) {
            if (!suiteStats[sid]) return;
            suiteStats[sid].total++;
            const status = classifyInversionStatus(row.inversion_success, row.comparison_message);
            suiteStats[sid][status.category]++;
        }

        function updateSuiteStatsDisplay(sid) {
            const s = suiteStats[sid];
            if (!s) return;
            $(`#ps-total-${sid}`).text(s.total);
            $(`#ps-passed-${sid}`).text(s.passed);
            $(`#ps-failed-${sid}`).text(s.failed);
            $(`#ps-ns-${sid}`).text(s.notSupported);
            $(`#ps-nt-${sid}`).text(s.notTested);
            $(`#ps-pi-${sid}`).text(s.partiallyInverted);
            $(`#ps-ni-${sid}`).text(s.nonInvertible);
            $(`#ps-fmf-${sid}`).text(s.forwardMappingFailed);
        }

        function createSuitePanelHtml(sid) {
            const name = sid.toUpperCase();
            const headerRow = compactHeaders.map(h => `<th>${h}</th>`).join('');
            return `
            <div class="suite-panel">
                <h3><span class="suite-badge suite-${sid}">${name}</span> test cases</h3>
                <div class="suite-panel-stats" id="panel-stats-${sid}">
                    <span>Total: <strong id="ps-total-${sid}">0</strong></span>
                    <span class="stat-passed">Fully inverted: <strong id="ps-passed-${sid}">0</strong></span>
                    <span class="stat-partially-inverted">Partially inverted: <strong id="ps-pi-${sid}">0</strong></span>
                    <span class="stat-non-invertible">Non-invertible: <strong id="ps-ni-${sid}">0</strong></span>
                    <span class="stat-not-supported">Not supported: <strong id="ps-ns-${sid}">0</strong></span>
                    <span class="stat-not-tested">Not tested: <strong id="ps-nt-${sid}">0</strong></span>
                    <span class="stat-forward-mapping-failed">Forward mapping failed: <strong id="ps-fmf-${sid}">0</strong></span>
                    <span class="stat-failed">Failed: <strong id="ps-failed-${sid}">0</strong></span>
                </div>
                <div class="suite-panel-table">
                    <table class="table table-striped table-sm">
                        <thead><tr>${headerRow}</tr></thead>
                        <tbody id="panel-body-${sid}"></tbody>
                    </table>
                </div>
            </div>`;
        }

        function generateCompactRow(response) {
            if (!response || !response.results || !Array.isArray(response.results.data) || response.results.data.length === 0) {
                return `<tr><td colspan="${compactHeaders.length}">Error: Invalid test result</td></tr>`;
            }
            const row = response.results.data[0];
            const tid = row.testid || 'N/A';
            const errorBadge = row.error_test ? '<span class="error-test-badge">error test</span>' : '';
            let html = '<tr>';
            html += `<td>${tid}${errorBadge}</td>`;
            html += `<td class="result-${(row.result || '').toLowerCase()}">${row.result || 'N/A'}</td>`;
            html += `<td><a href="#" onclick="showFileContent('${tid}', 'expected'); return false;" class="compact-link">View</a></td>`;
            html += `<td><a href="#" onclick="showFileContent('${tid}', 'actual'); return false;" class="compact-link">View</a></td>`;
            html += `<td><a href="#" onclick="showMapping('${tid}'); return false;" class="compact-link">View</a></td>`;
            const status = classifyInversionStatus(row.inversion_success, row.comparison_message);
            const tooltipHtml = status.tooltip ? ` <i class="bi bi-info-circle info-icon" data-bs-toggle="tooltip" data-bs-placement="top" title="${status.tooltip}"></i>` : '';
            html += `<td class="result-${status.cls}">${status.text}${tooltipHtml}</td>`;
            html += `<td><a href="#" onclick="showTableComparison('${tid}'); return false;" class="compact-link">View</a></td>`;
            html += '</tr>';
            return html;
        }

        function generateErrorRow(response) {
            const tid = response.test_id || 'N/A';
            const msg = response.message || 'Unknown error';
            const isDual = $('#dual-panel-wrapper').length > 0;
            if (isDual) {
                const tooltipMsg = escapeHtml(msg).replace(/'/g, '&apos;');
                let html = '<tr>';
                html += `<td>${escapeHtml(tid)}</td>`;
                html += '<td class="result-failed">failed</td>';
                html += `<td colspan="${compactHeaders.length - 4}"></td>`;
                html += `<td class="result-failed">Error <i class="bi bi-info-circle info-icon" data-bs-toggle="tooltip" data-bs-placement="top" title="${tooltipMsg}"></i></td>`;
                html += '<td></td>';
                html += '</tr>';
                return html;
            }
            const tooltipMsg = escapeHtml(msg).replace(/'/g, '&apos;');
            let html = '<tr>';
            const suiteId = response.suite_id || '';
            html += `<td>${getSuiteBadge(suiteId)}</td>`;
            html += `<td>${escapeHtml(tid)}</td>`;
            html += '<td></td>';
            html += '<td class="result-failed">failed</td>';
            html += '<td></td><td></td><td></td>';
            html += `<td class="result-failed">Error <i class="bi bi-info-circle info-icon" data-bs-toggle="tooltip" data-bs-placement="top" title="${tooltipMsg}"></i></td>`;
            html += '<td></td>';
            html += '</tr>';
            return html;
        }

        function showMapping(testId) {
            const response = testResults[testId];
            if (response && response.results && response.results.data && response.results.data[0]) {
                showModal('Mapping', `<pre>${escapeHtml(response.results.data[0].mapping)}</pre>`);
            } else {
                showModal('Error', 'Unable to display mapping. Invalid data structure.');
            }
        }

        function showModal(title, content) {
            const modal = document.getElementById('infoModal');
            const modalTitle = document.getElementById('modalTitle');
            const modalContent = document.getElementById('modalContent');

            modalTitle.textContent = title;
            modalContent.innerHTML = content;

            modalContent.style.maxHeight = '70vh';
            modalContent.style.overflow = 'auto';

            modal.style.display = 'block';

            const span = document.getElementsByClassName('close')[0];
            span.onclick = function() {
                modal.style.display = 'none';
            }

            window.onclick = function(event) {
                if (event.target == modal) {
                    modal.style.display = 'none';
                }
            }
        }

        function showTableComparison(testId) {
            const response = testResults[testId];
            if (response && response.results && response.results.data && response.results.data[0]) {
                const originalTables = response.results.data[0].original_tables;
                const invertedTables = response.results.data[0].inverted_tables;
                const comparisonMessage = response.results.data[0].comparison_message;

                let content = '';

                if (comparisonMessage) {
                    content += `<h3>Comparison message:</h3><p>${escapeHtml(comparisonMessage)}</p>`;
                }

                if (originalTables && typeof originalTables === 'object' && Object.keys(originalTables).length > 0) {
                    content += '<h3>Original tables:</h3>';
                    for (const [tableName, tableData] of Object.entries(originalTables)) {
                        content += `<h4>${tableName}</h4>`;
                        content += `<pre>${escapeHtml(JSON.stringify(tableData, null, 2))}</pre>`;
                    }
                } else {
                    content += '<h3>Original tables:</h3><p>No original table data available.</p>';
                }

                if (invertedTables && typeof invertedTables === 'object' && Object.keys(invertedTables).length > 0) {
                    content += '<h3>Inverted tables:</h3>';
                    for (const [tableName, tableData] of Object.entries(invertedTables)) {
                        content += `<h4>${tableName}</h4>`;
                        content += `<pre>${escapeHtml(JSON.stringify(tableData, null, 2))}</pre>`;
                    }
                } else {
                    content += '<h3>Inverted tables:</h3><p>No inverted table data available.</p>';
                }

                if (content === '') {
                    content = '<p>No table comparison data available.</p>';
                }

                showModal('Table comparison', content);
            } else {
                showModal('Error', 'Unable to display table comparison.');
            }
        }

        function initializeTooltips(scope = document) {
            var tooltipTriggerList = [].slice.call(scope.querySelectorAll('[data-bs-toggle="tooltip"]:not(.tooltip-initialized)'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                tooltipTriggerEl.classList.add('tooltip-initialized');
                return new bootstrap.Tooltip(tooltipTriggerEl, {
                    trigger: 'hover',
                    html: true
                });
            });
        }

        $(document).ready(function() {
            updateEngineFlow();
            updateSuiteAvailability();
            updateTestSelect();
            updateHeaderRow();
            initializeTooltips();

            $('#enginePairSelect').change(function() {
                updateEngineFlow();
                updateSuiteAvailability();
                updateTestSelect();
            });

            $('#databaseSelect').change(function() {
                updateSuiteAvailability();
                updateTestSelect();
            });

            $('#suiteSelect').change(function() {
                updateTestSelect();
            });

            $('#testSelect').change(function() {
                const selectedTest = $(this).val();
                $('#runTestBtn').prop('disabled', !selectedTest);
            });

            $('#runTestBtn').prop('disabled', true);
            $('#runAllTestsBtn').prop('disabled', false);
        });

        function getResultClass(result) {
            return result.toLowerCase() === 'passed' ? 'result-passed' : 'result-failed';
        }

        function truncateText(text, maxLength = 50) {
            return text.length > maxLength ? text.substring(0, maxLength) + '...' : text;
        }
    </script>
</body>
</html>
